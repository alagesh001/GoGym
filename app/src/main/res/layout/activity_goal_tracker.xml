<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".activity.GoalTracker">
    <ImageView
        android:id="@+id/back_iv"
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_40sdp"
        android:src="@drawable/backicn"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="@dimen/_10sdp"
        />



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:gravity="center_horizontal"
        app:layout_constraintEnd_toEndOf="parent">

<TextView
    android:id="@+id/mygoal_tv"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="My Goal"
    android:textColor="@color/black"
    android:textSize="@dimen/_20ssp"
    />
    <TextView
        android:id="@+id/type_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Weight Gain"
        android:textColor="#3000AB"
        android:textSize="@dimen/_30ssp"
        android:textStyle="bold"
        android:layout_marginTop="@dimen/_10sdp"

        />

    <TextView
        android:id="@+id/weight_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/weight_display"
        android:textColor="#020000"
        android:textSize="@dimen/_50ssp"
        android:textStyle="bold"
        android:layout_marginTop="@dimen/_40sdp"

        />
    <TextView
        android:id="@+id/lstrecord_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="- Last recorded weight -"
        android:textColor="#454545"
        android:textSize="@dimen/_10ssp"
        android:textStyle="normal"
        android:layout_marginTop="@dimen/_10sdp"


        />
    <Button
        android:id="@+id/btn_progresscheck"
        android:layout_width="@dimen/_150sdp"
        android:layout_height="wrap_content"
        android:text="Check Progress"
        android:layout_marginTop="@dimen/_40sdp"


        android:backgroundTint="#A800E4"
        android:textColor="@android:color/white"
        android:layout_alignParentEnd="true"
        />
    <Button
        android:id="@+id/btn_update"
        android:layout_width="@dimen/_150sdp"
        android:layout_height="wrap_content"
        android:text="Update Weight"
        android:layout_marginTop="@dimen/_10sdp"


        android:backgroundTint="#E90078"
        android:textColor="@android:color/white"
        android:layout_alignParentEnd="true"
        />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>